# ---- Primary interpreter: Groq (free tier, no card required) ----
# Get a key at https://console.groq.com/keys  (keys look like gsk_...)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Fallback interpreter: Google Gemini (free tier, no card required) ----
# Get a key at https://aistudio.google.com/apikey  (keys look like AIza...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Optional extra tier: xAI Grok (paid; NOT the same company as Groq) ----
# Leave blank unless you have a key from https://console.x.ai (keys look like xai-...)
# When set, it is tried after Groq and before Gemini.
XAI_API_KEY=
XAI_MODEL=grok-4-fast

# Seconds allowed for one provider call, and for the whole interpretation stage.
LLM_TIMEOUT_SECONDS=8
LLM_TOTAL_BUDGET_SECONDS=15

# Set to 1 to skip every provider and use the deterministic interpreter only.
LLM_DISABLED=

LOG_LEVEL=INFO
