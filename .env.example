# Primary interpreter (xAI Grok). Get a key at https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4-fast

# Fallback interpreter (Google Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Seconds allowed per LLM HTTP call before falling through to the next tier.
LLM_TIMEOUT_SECONDS=20

# Set to 1 to skip both providers and use the deterministic interpreter only.
LLM_DISABLED=

LOG_LEVEL=INFO
