# Force LF everywhere. Shell scripts, the systemd unit and the nginx config are
# checked out on Linux; a CRLF line ending makes bash fail with a confusing
# "\r: command not found" and systemd refuse the unit.
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
Dockerfile text eol=lf
Procfile   text eol=lf
.env.example text eol=lf
