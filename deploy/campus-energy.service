[Unit]
Description=Smart Campus Energy Optimization API
Documentation=https://github.com/muhammadMilon/BUP-Hackathon-Preli-2026
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=campus
Group=campus
# `current` is a symlink to the active release; deploy/release.sh flips it.
WorkingDirectory=/opt/campus-energy/current
EnvironmentFile=/opt/campus-energy/.env
ExecStart=/opt/campus-energy/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 3 \
    --timeout-keep-alive 65 \
    --no-access-log
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

# The box also hosts other production services, so this one is fenced in:
# read-only filesystem, no home directories, no privilege escalation.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=2G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=campus-energy

[Install]
WantedBy=multi-user.target
